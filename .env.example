# Copy to .env and set a long random string. Admin must send:
#   Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=change-me-to-a-long-secret

PORT=8787

# Optional: absolute public URL for uploaded images (Railway etc.)
# PUBLIC_BASE_URL=https://your-backend.up.railway.app

CONTACT_TO_EMAIL=hasanwahab078@gmail.com

# ——— Recommended on Railway (HTTPS — SMTP ports often blocked) ———
# 1) https://resend.com → sign up → API Keys → create key
# 2) Free test: from can stay onboarding@resend.dev (sends to your signup email)
# 3) Or verify your domain and set RESEND_FROM_EMAIL=Portfolio <you@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ——— Local / unrestricted networks only (Gmail SMTP) ———
# Railway often fails with ETIMEDOUT on smtp.gmail.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hasanwahab078@gmail.com
SMTP_PASS=your-16-char-app-password
