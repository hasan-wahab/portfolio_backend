# Copy to .env and set a long random string. Admin must send:
#   Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=change-me-to-a-long-secret

PORT=8787

# Optional: absolute public URL for uploaded images (Railway etc.)
# PUBLIC_BASE_URL=https://your-backend.up.railway.app

# ——— Contact form → your inbox (Gmail App Password) ———
# 1) Google Account → Security → 2-Step Verification ON
# 2) App passwords → create for "Mail" → paste 16-char password in SMTP_PASS
# NEVER put real passwords in this example file — only in .env
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hasanwahab078@gmail.com
SMTP_PASS=your-16-char-app-password
CONTACT_TO_EMAIL=hasanwahab078@gmail.com
